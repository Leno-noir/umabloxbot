# Required
DISCORD_TOKEN=
MONGODB_URI=
MAIN_GUILD_ID=

# Separate MongoDB database used by gacha through a user-installed application.
APPLICATION_MONGODB_DATABASE=umablox_application

# Optional; production-safe defaults
BOT_ENV=production
ROTECTOR_ENABLED=false

# Needed only when Rotection is intentionally enabled
ROTECTOR_API_KEY=
ROTECTOR_API_BASE_URL=https://roscoe.rotector.com
