# Discord Bot Token
# From here: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# MongoDB Connection URI
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=appname
MONGODB_URI=your_mongodb_connection_uri_here

# Main Guild ID (Discord Server ID)
# Right-click on server name > Copy Server ID (with Developer Mode enabled)
MAIN_GUILD_ID=your_guild_id_here
